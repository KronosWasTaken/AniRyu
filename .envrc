if has devenv; then
  eval "$(devenv direnvrc)"
  use devenv
fi

if has sops && [ -f secrets/dev.enc.env ] && [ ! -f .env.local ]; then
  log_status "decrypting secrets/dev.enc.env -> .env.local (sops)"
  sops decrypt secrets/dev.enc.env > .env.local 2>/dev/null || log_error "sops decrypt failed; run ./scripts/sops-setup.sh"
fi
if has sops && [ -f backend/dev.enc.env ] && [ ! -f backend/.env ]; then
  log_status "decrypting backend/dev.enc.env -> backend/.env (sops)"
  sops decrypt backend/dev.enc.env > backend/.env 2>/dev/null || log_error "sops decrypt failed; run ./scripts/sops-setup.sh"
fi

dotenv_if_exists .env.local
dotenv_if_exists backend/.env

watch_file mise.toml
watch_file devenv.nix
watch_file devenv.yaml
watch_file portless.json
watch_file .sops.yaml
